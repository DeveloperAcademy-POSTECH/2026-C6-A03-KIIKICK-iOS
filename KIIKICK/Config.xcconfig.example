// 이 파일을 복사해서 같은 폴더에 "Config.xcconfig"로 저장하세요 (git에는 안 올라갑니다, .gitignore 참고).
// xcconfig에서 "//"는 주석 시작이라, URL의 "//"는 $() 빈 매크로로 끊어서 이스케이프합니다.
BASE_URL = https:/$()/kiikick-api.duckdns.org

// 개인 기기 서명은 Git에서 제외된 Config.xcconfig에서만 변경하세요.
// 생략하면 프로젝트의 팀 공통 기본값을 사용합니다.
// KIIKICK_DEVELOPMENT_TEAM = YOUR_TEAM_ID
// KIIKICK_BUNDLE_IDENTIFIER = com.yourname.KIIKICK
// Watch 앱 ID와 WKCompanionAppBundleIdentifier는 위 앱 ID에서 자동으로 파생됩니다.
